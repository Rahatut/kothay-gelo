# DATABASE_URL: Use a local file for development or libSQL/HTTPS in production.
# Supabase/Postgres is the decided production target but is not wired yet; see
# specs/008-supabase-postgres/plan.md. Until then this stays libSQL.
DATABASE_URL="file:./data/kothay-gelo.db"
DATABASE_AUTH_TOKEN=""

# APP_URL: The public origin used for request-origin checks.
APP_URL="http://localhost:3000"

PORT="3000"
DEMO_SEED="1"

# GEMINI_API_KEY is optional; deterministic extraction and narration remain available without it.
# Paste your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Supabase / Postgres. Fill these in when the project exists.
# Poolers require user format: username.projectref
# Session pooler (port 5432) for the app:
# SUPABASE_APP_DB_URL="postgresql://kothay_app.<projectref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Transaction pooler (port 6543) for migrations (optional):
# SUPABASE_MIGRATION_DB_URL="postgresql://postgres.<projectref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_APP_DB_URL=""
SUPABASE_APP_DB_PASSWORD=""
