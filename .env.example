# Local development environment for Kothay Gelo?
# Copy to .env and fill in your values
# Never commit .env — it's in .gitignore

# Server runtime (required)
DATABASE_URL="file:./data/kothay-gelo.db"
APP_URL="http://localhost:3000"

# Server runtime (optional)
PORT="3000"
DEMO_SEED="1"
DATABASE_AUTH_TOKEN=""
# Comma-separated origins allowed to call the API, e.g. "https://user.github.io"
ALLOWED_ORIGINS=""

# Build time — client (read by vite.config.ts at build only)
# API origin only: no trailing slash, no /v1 suffix.
# Empty or unset = same-origin. Correct for local dev, because the Vite
# dev proxy forwards /v1 to DEV_API_TARGET.
# VITE_API_BASE_URL=https://your-api.onrender.com

# Build time — client
# Base path the built frontend is served from. Default "/" .
# GitHub Pages project sites need "/kothay-gelo/" ; GitHub Pages user sites
# and single-origin deploys (Render) use "/".
APP_BASE_PATH="/"

# Build time — dev only
# Origin the Vite dev proxy forwards /v1 to. Default "http://localhost:3000" .
DEV_API_TARGET="http://localhost:3000"

# LLM (optional — app degrades to deterministic parser without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Supabase / Postgres (optional — for migrations or remote DB)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_APP_DB_URL="postgresql://user:pass@host:port/db"
# SUPABASE_APP_DB_PASSWORD=
# SUPABASE_MIGRATION_DB_URL="postgresql://user:pass@host:port/db"
